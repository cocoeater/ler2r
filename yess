        while true do
            if isAutoFiring then
                -- Fires only if the auto-fire toggle is ON
                LaserGunsShared.ShootLocal()
            end
            
            -- Yield to prevent client freezing
            task.wait(FIRE_RATE_DELAY) 
        end
    end)
    
    print("------------------------------------------")
    print("Auto-Fire Keybind Initialized. Use 'X' to equip/toggle firing.")

else
    print("❌ Could not find the 'Laser Gun' tool.")
end
